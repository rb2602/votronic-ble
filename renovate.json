{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "configMigration": true,
  "timezone": "Europe/Zurich",
  "schedule": ["on saturday"],
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "description": "Also matches requirements-ha-test.txt.",
    "managerFilePatterns": ["/(^|/)requirements(-[\\w-]+)?\\.txt$/"]
  },
  "customDatasources": {
    "homeassistant-python": {
      "defaultRegistryUrlTemplate": "https://pypi.org/pypi/homeassistant/json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $substringAfter(info.requires_python, \">=\")}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "See Dependency updates in docs/development.md.",
      "managerFilePatterns": ["/^docs/development\\.md$/"],
      "matchStrings": ["Needs Python (?<currentValue>\\d+\\.\\d+(\\.\\d+)?) or newer"],
      "depNameTemplate": "homeassistant-python",
      "datasourceTemplate": "custom.homeassistant-python",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "See Upstream changes in docs/development.md.",
      "managerFilePatterns": ["/^docs/development\\.md$/"],
      "matchStrings": ["Last reviewed upstream commit: `(?<currentDigest>[0-9a-f]{40})`"],
      "depNameTemplate": "syssi/esphome-votronic",
      "packageNameTemplate": "https://github.com/syssi/esphome-votronic",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Pinned in two places, see Pinned tool versions in docs/development.md.",
      "groupName": "Ruff",
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"]
    },
    {
      "description": "Only action digests, not the upstream commits.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "groupName": "gitleaks",
      "matchPackageNames": ["zricethezav/gitleaks", "gitleaks/gitleaks"]
    },
    {
      "description": "Not for github-digest and git-refs, which have no release dates.",
      "matchDatasources": ["docker", "github-releases", "github-tags", "pypi"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "See Dependency updates in docs/development.md.",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "matchDepNames": ["homeassistant-python"],
      "commitMessageTopic": "Python required by Home Assistant",
      "prBodyNotes": [
        "Follow `Dependency updates` in `docs/development.md`: for a new minor version, move Python to it in this pull request; otherwise merge it as is."
      ]
    },
    {
      "description": "Calendar versions: the first release of a year is major, not breaking.",
      "matchPackageNames": ["homeassistant"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Matched by depName, as the package name is the GitHub URL.",
      "matchDepNames": ["syssi/esphome-votronic"],
      "commitMessageTopic": "upstream {{depName}}",
      "prBodyNotes": [
        "Upstream changes to review: https://github.com/syssi/esphome-votronic/compare/{{currentDigest}}...{{newDigest}}",
        "Follow `Upstream changes` in `docs/development.md`: transfer the changes to this pull request, or merge it as is when the commits do not touch `components/votronic_ble`."
      ]
    }
  ]
}
